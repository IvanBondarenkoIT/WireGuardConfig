# Пример структуры для переменной WG0_CONF в Railway (скопируйте и подставьте свои ключи).
# В GitHub кладите только этот файл-пример, без реальных ключей.

[Interface]
PrivateKey = <ВАШ_ПРИВАТНЫЙ_КЛЮЧ>
ListenPort = 51820
Address = 10.0.99.114/32
[Peer]
PublicKey = <ПУБЛИЧНЫЙ_КЛЮЧ_ПИРА>
AllowedIPs = 192.168.99.199/32
Endpoint = 178.63.72.227:36914
